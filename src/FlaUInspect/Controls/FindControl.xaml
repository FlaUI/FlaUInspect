<UserControl x:Class="FlaUInspect.Controls.FindControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FlaUInspect.Controls"
             mc:Ignorable="d"
              d:DesignWidth="300">
    <DockPanel LastChildFill="True">
        <TextBlock Text="Find by "
                   
                   x:Name="ConditionTextBlock"
                   Margin="0 0 8 0"/>
        <ComboBox x:Name="FindByComboBox"
                  DockPanel.Dock="Left"
                  SelectionChanged="FindByComboBoxSelectionChanged"/>
        <ComboBox x:Name="PropertyConditionFlagsComboBox"
                  DockPanel.Dock="Right"/>
        <Grid>
            <ComboBox x:Name="ControlTypeCombobox"/>
            <ComboBox x:Name="FrameworkTypeCombobox"/>
            <TextBox x:Name="CriteriaTextBox"/>
        </Grid>
    </DockPanel>
</UserControl>
